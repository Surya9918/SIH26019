# ==============================================================================
# SIH26019 - National Digital Platform for Land Governance Environment Config
# ==============================================================================

# Application
APP_ENV=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_PATH=data/land_governance.db

# Security & CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120

# AI & Semantic Search Configuration
EMBEDDING_MODEL=tfidf_semantic_hybrid_v1
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.12
ENABLE_LLM_FALLBACK=true

# GIS & Storage
DATA_STORAGE_PATH=./data/storage
ENABLE_SATELLITE_PROCESSING=true
DEMO_DATA_MODE=true
